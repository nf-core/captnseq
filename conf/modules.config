/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Local captnseq modules - ported from nfcore_HTTM. Containers and
    // execution_mode-scaled resources mirror what the hand-built pipeline was
    // already running in production; folder numbering matches its publishDir
    // layout so existing collaborators' expectations don't change.
    //
    withName: 'CUTADAPT' {
        cpus      = params.execution_mode == 'multi_thread' ? params.resources.cutadapt.multi.cpus   : params.resources.cutadapt.single.cpus
        memory    = params.execution_mode == 'multi_thread' ? params.resources.cutadapt.multi.memory : params.resources.cutadapt.single.memory
        time      = params.execution_mode == 'multi_thread' ? params.resources.cutadapt.multi.time   : params.resources.cutadapt.single.time
        container = 'quay.io/biocontainers/cutadapt:5.2--py312h247cb63_1'
        publishDir = [ path: { "${params.outdir}/01_cutadapt" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTP' {
        cpus      = params.execution_mode == 'multi_thread' ? params.resources.fastp.multi.cpus   : params.resources.fastp.single.cpus
        memory    = params.execution_mode == 'multi_thread' ? params.resources.fastp.multi.memory : params.resources.fastp.single.memory
        time      = params.execution_mode == 'multi_thread' ? params.resources.fastp.multi.time   : params.resources.fastp.single.time
        container = 'quay.io/biocontainers/fastp:0.23.2--h5f740d0_4'
        publishDir = [ path: { "${params.outdir}/02_QualTrim" }, mode: params.publish_dir_mode ]
    }
    withName: 'BWA_INDEX' {
        cpus      = 1
        memory    = '2 GB'
        time      = '30m'
        container = 'quay.io/biocontainers/bwa:0.7.18--he4a0461_1'
        publishDir = [ path: { "${params.outdir}/reference" }, mode: params.publish_dir_mode ]
    }
    withName: 'BWA_MEM' {
        cpus      = params.execution_mode == 'multi_thread' ? params.resources.map_reads.multi.cpus   : params.resources.map_reads.single.cpus
        memory    = params.execution_mode == 'multi_thread' ? params.resources.map_reads.multi.memory : params.resources.map_reads.single.memory
        time      = params.execution_mode == 'multi_thread' ? params.resources.map_reads.multi.time   : params.resources.map_reads.single.time
        container = 'quay.io/biocontainers/bwa:0.7.18--he4a0461_1'
    }
    withName: 'SAMTOOLS_SORT' {
        cpus      = params.execution_mode == 'multi_thread' ? params.resources.map_reads.multi.cpus   : params.resources.map_reads.single.cpus
        memory    = params.execution_mode == 'multi_thread' ? params.resources.map_reads.multi.memory : params.resources.map_reads.single.memory
        time      = params.execution_mode == 'multi_thread' ? params.resources.map_reads.multi.time   : params.resources.map_reads.single.time
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
        publishDir = [ path: { "${params.outdir}/03_mapped" }, mode: params.publish_dir_mode ]
    }
    withName: 'MARK_DUPLICATES' {
        cpus      = params.execution_mode == 'multi_thread' ? params.resources.mark_duplicates.multi.cpus   : params.resources.mark_duplicates.single.cpus
        memory    = params.execution_mode == 'multi_thread' ? params.resources.mark_duplicates.multi.memory : params.resources.mark_duplicates.single.memory
        time      = params.execution_mode == 'multi_thread' ? params.resources.mark_duplicates.multi.time   : params.resources.mark_duplicates.single.time
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
        publishDir = [ path: { "${params.outdir}/04_filtered" }, mode: params.publish_dir_mode ]
    }
    withName: 'FLAGSTAT' {
        cpus      = 1
        memory    = '10 GB'
        time      = '120m'
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
        publishDir = [ path: { "${params.outdir}/03_mapped" }, mode: params.publish_dir_mode ]
    }
    withName: 'BAM2SAM' {
        cpus      = params.execution_mode == 'multi_thread' ? params.resources.bam2sam.multi.cpus   : params.resources.bam2sam.single.cpus
        memory    = params.execution_mode == 'multi_thread' ? params.resources.bam2sam.multi.memory : params.resources.bam2sam.single.memory
        time      = params.execution_mode == 'multi_thread' ? params.resources.bam2sam.multi.time   : params.resources.bam2sam.single.time
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
        publishDir = [ path: { "${params.outdir}/05_sitescall" }, mode: params.publish_dir_mode ]
    }
    withName: 'SAM2SITES' {
        // Snakefile's sam2sites rule hardcodes these (no
        // multi_thread_resources entry) - see bin/sam2sites.py's memory-hungry
        // engine="python" pd.read_csv call.
        cpus      = 1
        memory    = '50 GB'
        time      = '600m'
        container = 'quay.io/biocontainers/pandas:2.2.1'
        publishDir = [ path: { "${params.outdir}/05_sitescall" }, mode: params.publish_dir_mode ]
    }
    withName: 'INTERSECT' {
        // pipeline_ref/Snakefile's intersect/sites2genes/statisti_call rules
        // all hardcode threads=1, mem_mb=10000, runtime=90 (no
        // multi_thread_resources entry for any of the three).
        cpus      = 1
        memory    = '10 GB'
        time      = '90m'
        container = 'quay.io/biocontainers/bedtools:2.30.0--hc088bd4_0'
        publishDir = [ path: { "${params.outdir}/06_intersection" }, mode: params.publish_dir_mode ]
    }
    withName: 'SITES2GENES' {
        cpus      = 1
        memory    = '10 GB'
        time      = '90m'
        container = 'quay.io/biocontainers/pandas:2.2.1'
        publishDir = [ path: { "${params.outdir}/07_statisticalreport" }, mode: params.publish_dir_mode ]
    }
    withName: 'STATISTI_CALL' {
        cpus      = 1
        memory    = '10 GB'
        time      = '90m'
        container = 'quay.io/biocontainers/pandas:2.2.1'
        publishDir = [ path: { "${params.outdir}/07_statisticalreport" }, mode: params.publish_dir_mode ]
    }
    withName: 'GREP_OTHER_CHROMOSOMES' {
        cpus      = 1
        memory    = '2 GB'
        time      = '240m'
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
        publishDir = [ path: { "${params.outdir}/04_filtered" }, mode: params.publish_dir_mode ]
    }
    withName: 'PRODUCE_MAPPED_READ_COUNTS|PRODUCE_INSERTION_COUNTS' {
        // Plain POSIX shell (grep/awk/wc/basename) - no envmodules in the
        // Snakefile for these either, resolved via PATH there too.
        cpus      = 1
        memory    = '10 GB'
        time      = '180m'
        publishDir = [ path: { "${params.outdir}/09_sample_summary" }, mode: params.publish_dir_mode ]
    }
    withName: 'PRODUCE_CHR_COUNTS' {
        cpus      = 1
        memory    = '10 GB'
        time      = '180m'
        container = 'quay.io/biocontainers/pandas:2.2.1'
        publishDir = [ path: { "${params.outdir}/09_sample_summary" }, mode: params.publish_dir_mode ]
    }

}
